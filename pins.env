# What a release of this repository is built from. A release is tagged
# v$LBUG_VERSION-mee.$MEE_RELEASE; the workflow refuses a tag that does not
# match. MEE_RELEASE starts at 1 for each LadybugDB version and goes up when
# anything else below changes.
LBUG_VERSION=0.22.1
MEE_RELEASE=1
# ladybugdb/extensions at the commit LadybugDB 0.22.1 pins.
EXTENSIONS_COMMIT=119912e604ebbaad64072a701698d6fcf4140051
# The Android build: NDK r27b, API level 24, the NDK's shared C++ library.
ANDROID_NDK_VERSION=27.1.12297006
ANDROID_API=24
# OpenSSL 3 for Android, as the openssl-src crate packs it (crate version
# 300.x.y+<OpenSSL version>); Android offers apps no OpenSSL of its own.
OPENSSL_SRC_VERSION=300.6.1+3.6.3
